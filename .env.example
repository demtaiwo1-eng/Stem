# Neon Postgres connection string for the STEM database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=require

# Neon private Object Storage
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://br-calm-term-bd9di0xb.storage.c-8.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_FORCE_PATH_STYLE=true
STEM_BUCKET=stem-audio-private

# FAL hosted Demucs inference (server-side only)
FAL_API_KEY=YOUR_FAL_API_KEY
FAL_MODEL=fal-ai/demucs

# Application settings
PORT=8787
DATA_DIR=/data
MAX_UPLOAD_MB=250
MAX_ZIP_TRACKS=20
MAX_ZIP_UNPACKED_MB=1024
STEM_MODEL=htdemucs_6s
ALLOWED_ORIGIN=https://demtaiwo1-eng.github.io
