# Neon Postgres pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=require

# Neon Object Storage settings for the stem-audio-private bucket
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.YOUR_NEON_PROXY_HOST
AWS_REGION=us-east-2
STEM_BUCKET=stem-audio-private

# Application settings
PORT=8787
DATA_DIR=/data
MAX_UPLOAD_MB=250
STEM_DEVICE=cpu
STEM_MODEL=htdemucs_6s
ALLOWED_ORIGIN=https://demtaiwo1-eng.github.io
