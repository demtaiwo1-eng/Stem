{
  "name": "stem-audio-workbench",
  "version": "3.0.0",
  "private": true,
  "description": "FAL Demucs audio stem separation API backed by Neon Postgres and private object storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/release-gate.mjs",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "@aws-sdk/lib-storage": "^3.850.0",
    "express-rate-limit": "^7.5.0",
    "unzipper": "^0.12.3"
  }
}
